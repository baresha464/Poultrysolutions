@page "/welcome"
@attribute [AllowAnonymous]
@layout EmptyLayout

@* Public start page: what BroilIQ is and what it does, for visitors who aren't signed in yet.
   Anonymous visits to "/" land here (see RedirectToLogin and the cookie OnRedirectToLogin event);
   "Log in" goes to the normal sign-in page. Signed-in users get "Open dashboard" instead. *@

<PageTitle>@AppBrand.Name — @L["Broiler farm management for contract growers"]</PageTitle>

<div class="lp">
    @* ---------------- Top bar ---------------- *@
    <header class="lp-nav">
        <a class="lp-brand" href="welcome">
            <img src="@AppBrand.MarkUrl" alt="" />
            <span>@AppBrand.Name</span>
        </a>
        <nav class="lp-nav-links">
            <a href="welcome#story">@L["Our story"]</a>
            <a href="welcome#features">@L["Features"]</a>
            <a href="welcome#how">@L["How it works"]</a>
            <a href="welcome#addons">@L["AI & WhatsApp"]</a>
            <a href="welcome#faq">@L["FAQ"]</a>
            <a href="welcome#contact">@L["Contact"]</a>
        </nav>
        <div class="lp-nav-actions">
            <LanguageToggle />
            @if (signedIn)
            {
                <a class="btn btn-primary" href="">@L["Open dashboard"] <span class="material-symbols-outlined">arrow_forward</span></a>
            }
            else
            {
                <a class="btn btn-amber lp-nav-demo" href="welcome#demo">@L["Request a demo"]</a>
                <a class="btn btn-primary" href="Account/Login">@L["Log in"] <span class="material-symbols-outlined">login</span></a>
            }
        </div>
    </header>

    @* ---------------- Hero ---------------- *@
    <section class="lp-hero">
        <div class="lp-hero-bg" style="background-image:url('images/farm/farm-aerial-day.jpg')"></div>
        <div class="lp-hero-inner">
            <div class="lp-hero-copy">
                <span class="lp-eyebrow"><span class="material-symbols-outlined">agriculture</span> @L["Built by broiler farmers, for broiler farmers"]</span>
                <h1>@L["Run every batch like your best batch."]</h1>
                <p>@L["BroilIQ is a simple farm app for broiler growers. Record each shed's day in a minute, see how your flock compares with the breed standard, catch problems early, and know what the integrator owes you — on any phone, in English or Telugu."]</p>
                <div class="lp-hero-cta">
                    @if (signedIn)
                    {
                        <a class="btn btn-amber lp-btn-lg" href="">@L["Open dashboard"] <span class="material-symbols-outlined">arrow_forward</span></a>
                    }
                    else
                    {
                        <a class="btn btn-amber lp-btn-lg" href="welcome#demo">@L["Request a free demo"] <span class="material-symbols-outlined">event_available</span></a>
                        <a class="btn btn-ghost lp-btn-lg" href="Account/Login">@L["Log in to your farm"] <span class="material-symbols-outlined">login</span></a>
                    }
                </div>
                <ul class="lp-hero-points">
                    <li><span class="material-symbols-outlined">translate</span> @L["English & Telugu"]</li>
                    <li><span class="material-symbols-outlined">smartphone</span> @L["Works on any phone"]</li>
                    <li><span class="material-symbols-outlined">home_work</span> @L["Every shed, one dashboard"]</li>
                </ul>
            </div>

            @* Illustrative product preview (sample numbers) *@
            <div class="lp-hero-visual" aria-hidden="true">
                <div class="lp-mock">
                    <div class="lp-mock-head">
                        <div class="lp-mock-chip" style="background-image:url('images/farm/thumb-1.jpg')">H1</div>
                        <div>
                            <div class="lp-mock-title">@L["House 1"] <span class="lp-mock-day">@L["Day {0}", 24]</span></div>
                            <div class="lp-mock-sub">Cobb 430Y · 5,000 @L["chicks"]</div>
                        </div>
                        <div class="lp-mock-score"><svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="18" class="t" /><circle cx="22" cy="22" r="18" class="f" stroke-dasharray="104 113.1" transform="rotate(-90 22 22)" /></svg><b>92</b></div>
                    </div>
                    <div class="lp-mock-progress"><span style="width:57%"></span></div>
                    <div class="lp-mock-stats">
                        <div><span>@L["Live Birds"]</span><b>4,921</b></div>
                        <div><span>@L["Avg Weight"]</span><b>1.08 kg</b></div>
                        <div><span>FCR</span><b>1.38</b></div>
                        <div><span>@L["Livability"]</span><b>98.4%</b></div>
                    </div>
                    <div class="lp-mock-spark">
                        <svg viewBox="0 0 300 70" preserveAspectRatio="none">
                            <path d="M0,66 C40,64 70,60 100,52 C140,42 170,32 200,22 C230,14 260,8 300,4" class="std" />
                            <path d="M0,67 C40,65 70,59 100,50 C140,39 170,29 200,19 C230,11 260,6 300,2" class="act" />
                        </svg>
                        <div class="lp-mock-legend"><span class="act"></span>@L["Your flock"] <span class="std"></span>@L["Breed standard"]</div>
                    </div>
                </div>
                <div class="lp-bubble">
                    <span class="material-symbols-outlined">chat</span>
                    <div>
                        <b>@L["House 2 · heat stress"]</b>
                        <span>@L["36 °C at 2 PM — start foggers, give extra water."]</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ---------------- What it answers ---------------- *@
    <section class="lp-strip">
        <div><span class="material-symbols-outlined">timer</span><b>@L["1 minute"]</b><span>@L["to log a shed's day"]</span></div>
        <div><span class="material-symbols-outlined">speed</span><b>@L["0–100"]</b><span>@L["batch score, every day"]</span></div>
        <div><span class="material-symbols-outlined">picture_as_pdf</span><b>@L["3 reports"]</b><span>@L["ready to print or share"]</span></div>
        <div><span class="material-symbols-outlined">translate</span><b>@L["2 languages"]</b><span>@L["English and Telugu"]</span></div>
    </section>

    @* ---------------- Photo strip (slow auto-scroll; the list is doubled so it loops seamlessly) ---------------- *@
    <section class="lp-gallery" aria-label="@L["Broiler farms"]">
        <div class="lp-gallery-track">
            @for (var pass = 0; pass < 2; pass++)
            {
                foreach (var g in Gallery)
                {
                    <figure aria-hidden="@(pass == 1 ? "true" : "false")">
                        <img src="images/farm/@g.File" alt="@(pass == 0 ? L[g.Caption].Value : "")" loading="lazy" />
                        <figcaption>@L[g.Caption]</figcaption>
                    </figure>
                }
            }
        </div>
    </section>

    @* ---------------- Our story ---------------- *@
    <section class="lp-section lp-story" id="story">
        <div class="lp-story-photo">
            <img src="images/farm/farm-aerial-sunset.jpg" alt="@L["A broiler farm at sunset"]" loading="lazy" />
            <div class="lp-story-stamp"><b>10+</b><span>@L["years in broiler farming"]</span></div>
        </div>
        <div class="lp-story-copy">
            <span class="lp-kicker">@L["Our story"]</span>
            <h2>@L["Built by farmers who have lived every batch"]</h2>
            <p>@L["We are broiler farmers. For more than ten years we have raised flocks for integrators — through summer heat that took birds overnight, sick flocks we noticed too late, feed that ran out on a Sunday, and settlements we couldn't question because our records were in a torn notebook."]</p>
            <p>@L["We learned every lesson the hard way. BroilIQ is everything we wish we had on day one: a simple way to see how the flock is really doing, catch trouble early, and stand up for the fair price of our hard work."]</p>
            <blockquote class="lp-story-quote">
                <span class="material-symbols-outlined">format_quote</span>
                @L["Every batch is our family's income. We built this so no farmer has to lose a batch — or an argument about one — for lack of good records."]
                <cite>— @L["The BroilIQ founding farmers"]</cite>
            </blockquote>
            <ul class="lp-story-points">
                <li><span class="material-symbols-outlined">thermostat</span> @L["Heat waves and sudden mortality"]</li>
                <li><span class="material-symbols-outlined">receipt_long</span> @L["Settlement cuts we couldn't check"]</li>
                <li><span class="material-symbols-outlined">inventory_2</span> @L["Feed shortages and late deliveries"]</li>
                <li><span class="material-symbols-outlined">menu_book</span> @L["Years of notebook records"]</li>
            </ul>
        </div>
    </section>

    @* ---------------- Problem → solution ---------------- *@
    <section class="lp-section">
        <div class="lp-section-head">
            <span class="lp-kicker">@L["Why BroilIQ"]</span>
            <h2>@L["Your income depends on a few numbers. Watch them every day."]</h2>
            <p>@L["In contract farming you are paid on weight, FCR and mortality. Notebook records make it hard to see a problem until the batch is over — and hard to question a settlement."]</p>
        </div>
        <div class="lp-compare">
            <div class="lp-compare-col before">
                <h3><span class="material-symbols-outlined">menu_book</span> @L["Without it"]</h3>
                <ul>
                    <li>@L["Deaths, feed and weights scattered across notebooks"]</li>
                    <li>@L["Poor growth noticed only at lifting"]</li>
                    <li>@L["Feed runs out or vaccinations are missed"]</li>
                    <li>@L["No easy way to check the integrator's settlement"]</li>
                </ul>
            </div>
            <div class="lp-compare-col after">
                <h3><span class="material-symbols-outlined">verified</span> @L["With BroilIQ"]</h3>
                <ul>
                    <li>@L["Every shed's day in one place, entered in a minute"]</li>
                    <li>@L["Weight and FCR compared with the breed standard daily"]</li>
                    <li>@L["Warnings for feed stock, heat and vaccinations"]</li>
                    <li>@L["Expected settlement worked out from your own records"]</li>
                </ul>
            </div>
        </div>
    </section>

    @* ---------------- Features ---------------- *@
    <section class="lp-section lp-alt" id="features">
        <div class="lp-section-head">
            <span class="lp-kicker">@L["Features"]</span>
            <h2>@L["Everything a broiler farm needs, from placement to settlement"]</h2>
        </div>
        <div class="lp-features">
            @foreach (var f in FeatureList)
            {
                <div class="lp-feature">
                    <span class="lp-feature-icon material-symbols-outlined">@f.Icon</span>
                    <h3>@L[f.Title]</h3>
                    <p>@L[f.Text]</p>
                </div>
            }
        </div>
    </section>

    @* ---------------- Showcase rows ---------------- *@
    <section class="lp-section">
        <div class="lp-show">
            <img src="images/farm/supervisor-tablet.jpg" alt="@L["Supervisor recording the day in the shed"]" loading="lazy" />
            <div>
                <span class="lp-kicker">@L["Daily Record"]</span>
                <h2>@L["Built for the shed, not the office"]</h2>
                <p>@L["Big buttons for deaths, culls and feed bags, \"same as yesterday\" for routine values, and gentle warnings when a number looks wrong. Supervisors see only the houses they're assigned to."]</p>
                <ul class="lp-checks">
                    <li>@L["Deaths, culls, feed, water, weight and shed temperature"]</li>
                    <li>@L["Feed kg worked out from bags automatically"]</li>
                    <li>@L["Vaccinations, medicines, feed deliveries and lifting"]</li>
                </ul>
            </div>
        </div>
        <div class="lp-show reverse">
            <img src="images/farm/bird-weighing.jpg" alt="@L["Weighing a sample bird"]" loading="lazy" />
            <div>
                <span class="lp-kicker">@L["Batch score & advice"]</span>
                <h2>@L["Know how the flock is doing — and what to fix"]</h2>
                <p>@L["Each active batch gets a 0–100 score from FCR, growth, livability, vaccinations and shed conditions. Hover on it for the breakdown and the one or two things that need attention today."]</p>
                <ul class="lp-checks">
                    <li>@L["Growth and FCR against the Cobb/Ross standard for the bird's age"]</li>
                    <li>@L["Mortality against your integrator's allowance"]</li>
                    <li>@L["Days of feed left in stock"]</li>
                </ul>
            </div>
        </div>
        <div class="lp-show">
            <img src="images/farm/cooling-pads.jpg" alt="@L["Environment-controlled broiler shed"]" loading="lazy" />
            <div>
                <span class="lp-kicker">@L["Reports"]</span>
                <h2>@L["Learn from every batch"]</h2>
                <p>@L["Download PDF reports that show what made your best batch different from your weakest one — by house, season and integrator — with an action plan for the next placement."]</p>
                <ul class="lp-checks">
                    <li>@L["Batch close-out report with growth charts"]</li>
                    <li>@L["Batch comparison with the drivers of good results"]</li>
                    <li>@L["Financial summary of income and shed expenses"]</li>
                </ul>
            </div>
        </div>
    </section>

    @* ---------------- How it works ---------------- *@
    <section class="lp-section lp-alt" id="how">
        <div class="lp-section-head">
            <span class="lp-kicker">@L["How it works"]</span>
            <h2>@L["Three steps, every batch"]</h2>
        </div>
        <div class="lp-steps">
            <div class="lp-step"><img class="lp-step-img" src="images/farm/chicks-brooding.jpg" alt="" loading="lazy" /><span class="lp-step-n">1</span><h3>@L["Place the batch"]</h3><p>@L["Pick the house and integrator. Chick cost, feed bag weight and target weight fill in from the integrator's terms."]</p></div>
            <div class="lp-step"><img class="lp-step-img" src="images/farm/bird-drinking-line.jpg" alt="" loading="lazy" /><span class="lp-step-n">2</span><h3>@L["Log each day"]</h3><p>@L["Deaths, feed, weight and temperature in about a minute per shed — from the shed itself, on a phone."]</p></div>
            <div class="lp-step"><img class="lp-step-img" src="images/farm/healthy-birds.jpg" alt="" loading="lazy" /><span class="lp-step-n">3</span><h3>@L["Act and improve"]</h3><p>@L["Follow the score and warnings during the batch, check the settlement at the end, and compare batches to do better next time."]</p></div>
        </div>
    </section>

    @* ---------------- Who it's for ---------------- *@
    <section class="lp-section">
        <div class="lp-section-head">
            <span class="lp-kicker">@L["Who it's for"]</span>
            <h2>@L["One app for everyone on the farm"]</h2>
        </div>
        <div class="lp-roles">
            <div class="lp-role" style="background-image:linear-gradient(180deg, rgba(7,40,60,.1), rgba(7,40,60,.85)), url('images/farm/farm-aerial-sunset.jpg')">
                <span class="material-symbols-outlined">person</span>
                <h3>@L["Farm owners"]</h3>
                <p>@L["See every shed at a glance, compare batches and check what you're paid."]</p>
            </div>
            <div class="lp-role" style="background-image:linear-gradient(180deg, rgba(7,40,60,.1), rgba(7,40,60,.85)), url('images/farm/shed-feeders.jpg')">
                <span class="material-symbols-outlined">engineering</span>
                <h3>@L["Supervisors & shed staff"]</h3>
                <p>@L["Enter the day's record quickly and get reminders for feed and vaccinations."]</p>
            </div>
            <div class="lp-role" style="background-image:linear-gradient(180deg, rgba(7,40,60,.1), rgba(7,40,60,.85)), url('images/farm/feed-silo.jpg')">
                <span class="material-symbols-outlined">admin_panel_settings</span>
                <h3>@L["Admins"]</h3>
                <p>@L["Add users, choose what each role can see or edit, and assign houses."]</p>
            </div>
        </div>
    </section>

    @* ---------------- Add-ons ---------------- *@
    <section class="lp-section lp-dark" id="addons">
        <div class="lp-section-head">
            <span class="lp-kicker">@L["Optional add-ons"]</span>
            <h2>@L["Extra help when you need it"]</h2>
            <p>@L["Switched on for your farm on request — each farm uses its own AI and WhatsApp account, so costs stay separate."]</p>
        </div>
        @* ---- AI Assistant ---- *@
        <div class="lp-addon-row">
            <div class="lp-addon-copy">
                <span class="lp-addon-badge ai"><span class="material-symbols-outlined">smart_toy</span> @L["AI Assistant"]</span>
                <h3>@L["A health check from a photo, and answers about your own batch"]</h3>
                <p>@L["Upload photos of sick birds for an instant health check, and ask questions about your batch in English or Telugu. The assistant reads your own daily records, weights, feed and health log."]</p>
                <ul class="lp-addon-list">
                    <li><b>@L["Photo Health Check"]</b> — @L["up to 4 photos of birds, droppings, litter or post-mortem findings, with the symptoms you tick"]</li>
                    <li><b>@L["Clear result"]</b> — @L["possible conditions with likelihood, how urgent it is, what to do now and what to check"]</li>
                    <li><b>@L["Safety first"]</b> — @L["tells you when to call the vet and warns about notifiable diseases such as bird flu"]</li>
                    <li><b>@L["Farm assistant chat"]</b> — @L["ask \"Why did mortality go up this week?\" or \"When should I lift?\" and get answers from your records"]</li>
                </ul>
                <small>@L["Suggestions only — always confirm with your vet."]</small>
            </div>
            <div class="lp-ai-mock" aria-hidden="true">
                <div class="lp-ai-photos">
                    <img src="images/farm/shed-dim-stress.jpg" alt="" />
                    <img src="images/farm/healthy-birds.jpg" alt="" />
                    <span class="lp-ai-add"><span class="material-symbols-outlined">add_a_photo</span></span>
                </div>
                <div class="lp-ai-result">
                    <div class="lp-ai-tags"><span class="u">@L["Act today"]</span><span class="v"><span class="material-symbols-outlined">call</span> @L["Call your vet"]</span></div>
                    <div class="lp-ai-cond"><b>@L["Coccidiosis"]</b><span class="hi">@L["high likelihood"]</span></div>
                    <div class="lp-ai-cond"><b>@L["Necrotic enteritis"]</b><span class="md">@L["medium likelihood"]</span></div>
                    <div class="lp-ai-do"><span class="material-symbols-outlined">task_alt</span> @L["Remove wet litter around drinkers today"]</div>
                </div>
                <div class="lp-ai-chat">
                    <div class="q">@L["How can I improve FCR in the remaining days?"]</div>
                    <div class="a"><span class="lp-typing"><span></span><span></span><span></span></span></div>
                </div>
            </div>
        </div>

        @* ---- WhatsApp alerts ---- *@
        <div class="lp-addon-row reverse">
            <div class="lp-addon-copy">
                <span class="lp-addon-badge wa"><span class="material-symbols-outlined">chat</span> @L["WhatsApp Alerts"]</span>
                <h3>@L["Problems reach your phone before they cost you"]</h3>
                <p>@L["Death spikes, heat, low feed, vaccination reminders and an evening summary sent to your phone on WhatsApp, in English or Telugu."]</p>
                <ul class="lp-addon-list">
                    <li><b>@L["Death spike"]</b> — @L["when a day's deaths jump well above the recent average"]</li>
                    <li><b>@L["Heat and cold stress"]</b> — @L["when the shed temperature is dangerous for the birds' age"]</li>
                    <li><b>@L["Feed running low"]</b> — @L["about 2 days before feed runs out"]</li>
                    <li><b>@L["Vaccinations"]</b> — @L["a reminder the day before each dose, and a note if one looks missed"]</li>
                    <li><b>@L["Missing daily record"]</b> — @L["at 8 PM if today's entry hasn't been made"]</li>
                    <li><b>@L["Evening summary"]</b> — @L["deaths, weight, FCR, feed left and score for each batch, at the time you choose"]</li>
                </ul>
                <small>@L["Each person chooses which alerts they want."]</small>
            </div>
            <div class="lp-phone" aria-hidden="true">
                <div class="lp-phone-top"><img src="@AppBrand.MarkUrl" alt="" /> <b>@AppBrand.Name</b></div>
                <div class="lp-wa-msg"><b>⚠ @L["House 2 · death spike"]</b>@L["38 deaths today — about 3× the usual. Check drinkers and send 2 birds for post-mortem."]<span>7:42 AM</span></div>
                <div class="lp-wa-msg"><b>🌡 @L["House 1 · heat stress"]</b>@L["36 °C at 2 PM — start foggers, give extra water."]<span>2:05 PM</span></div>
                <div class="lp-wa-msg"><b>📊 @L["Daily summary · House 3"]</b>@L["Day 24 · 11 deaths · 1.08 kg · FCR 1.38 · feed for 4 days · score 92"]<span>7:00 PM</span></div>
            </div>
        </div>
    </section>

    @* ---------------- FAQ ---------------- *@
    <section class="lp-section" id="faq">
        <div class="lp-section-head">
            <span class="lp-kicker">@L["FAQ"]</span>
            <h2>@L["Common questions"]</h2>
        </div>
        <div class="lp-faq">
            @foreach (var q in Faq)
            {
                <details>
                    <summary>@L[q.Q]</summary>
                    <p>@L[q.A]</p>
                </details>
            }
        </div>
    </section>

    @* ---------------- Request a demo ---------------- *@
    <section class="lp-section lp-alt" id="demo">
        <div class="lp-demo">
            <div class="lp-demo-intro">
                <span class="lp-kicker">@L["Free demo"]</span>
                <h2>@L["See BroilIQ on your own farm"]</h2>
                <p>@L["Tell us a little about your farm. A farmer from our team will call you, show you the app on your phone in English or Telugu, and help set up your sheds — free of cost."]</p>
                <ul class="lp-checks">
                    <li>@L["A 20-minute call or farm visit, at a time that suits you"]</li>
                    <li>@L["Your sheds and integrator set up for you"]</li>
                    <li>@L["No payment details needed"]</li>
                </ul>
                <img src="images/farm/supervisor-tablet.jpg" alt="" loading="lazy" class="lp-demo-photo" />
            </div>

            <div class="lp-demo-card">
                @if (demoSent)
                {
                    <div class="lp-demo-done">
                        <span class="material-symbols-outlined">check_circle</span>
                        <h3>@L["Thank you, {0}!", demo.Name]</h3>
                        <p>@L["We have your request. Our team will call you on {0} within one working day.", demo.Phone]</p>
                        <a class="btn btn-ghost-dark" href="@DemoWhatsAppLink" target="_blank" rel="noopener">
                            <span class="material-symbols-outlined">chat</span> @L["Also send it on WhatsApp"]
                        </a>
                    </div>
                }
                else
                {
                    <h3>@L["Request a free demo"]</h3>
                    <div class="form-grid">
                        <div class="field">
                            <label>@L["Your name"] *</label>
                            <input @bind="demo.Name" maxlength="80" autocomplete="name" />
                        </div>
                        <div class="field">
                            <label>@L["Mobile number"] *</label>
                            <input @bind="demo.Phone" type="tel" inputmode="tel" maxlength="20" autocomplete="tel" placeholder="98765 43210" />
                        </div>
                        <div class="field">
                            <label>@L["Village / district"]</label>
                            <input @bind="demo.Location" maxlength="100" />
                        </div>
                        <div class="field">
                            <label>@L["Integrator you grow for"]</label>
                            <input @bind="demo.Integrator" maxlength="80" />
                        </div>
                        <div class="field">
                            <label>@L["Number of sheds"]</label>
                            <input @bind="demo.Sheds" type="number" min="1" max="999" inputmode="numeric" />
                        </div>
                        <div class="field">
                            <label>@L["Birds per batch"]</label>
                            <input @bind="demo.BirdsPerBatch" type="number" min="100" step="500" inputmode="numeric" />
                        </div>
                        <div class="field full">
                            <label>@L["Anything you'd like us to know?"]</label>
                            <textarea @bind="demo.Message" rows="2" maxlength="500"></textarea>
                        </div>
                        @* Honeypot: hidden from people, often filled in by bots. *@
                        <div class="lp-hp" aria-hidden="true">
                            <label>Website</label>
                            <input @bind="honeypot" tabindex="-1" autocomplete="off" />
                        </div>
                    </div>
                    @if (demoError is not null)
                    {
                        <div class="ai-error">@demoError</div>
                    }
                    <button class="btn btn-amber btn-block lp-btn-lg" @onclick="SubmitDemo" disabled="@demoBusy">
