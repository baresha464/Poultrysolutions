@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Inject] private DemoRequestService DemoRequests { get; set; } = default!;
    private bool signedIn;

    // ---- Request a demo ----
    private DemoRequest demo = new();
    private string honeypot = "";
    private bool demoSent, demoBusy;
    private string? demoError;

    private async Task SubmitDemo()
    {
        demoError = null;
        if (!string.IsNullOrEmpty(honeypot)) { demoSent = true; return; }   // bot: pretend it worked
        if (string.IsNullOrWhiteSpace(demo.Name) || string.IsNullOrWhiteSpace(demo.Phone))
        {
            demoError = L["Please enter your name and mobile number."];
            return;
        }
        demoBusy = true;
        demo.Language = AppLanguages.Current;
        var result = await DemoRequests.SubmitAsync(demo);
        demoBusy = false;
        switch (result)
        {
            case DemoRequestService.SubmitResult.Saved: demoSent = true; break;
            case DemoRequestService.SubmitResult.Invalid: demoError = L["Enter a valid mobile number, e.g. 98765 43210 or +91 98765 43210."]; break;
            default: demoError = L["We already have your request — our team will call you soon."]; break;
        }
    }

    /// <summary>The same request as a pre-filled WhatsApp message to the BroilIQ team.</summary>
    private string DemoWhatsAppLink
    {
        get
        {
            var parts = new List<string> { $"Hi BroilIQ, I'd like a free demo.", $"Name: {demo.Name}", $"Phone: {demo.Phone}" };
            if (!string.IsNullOrWhiteSpace(demo.Location)) parts.Add($"Location: {demo.Location}");
            if (!string.IsNullOrWhiteSpace(demo.Integrator)) parts.Add($"Integrator: {demo.Integrator}");
            if (demo.Sheds is > 0) parts.Add($"Sheds: {demo.Sheds}");
            if (demo.BirdsPerBatch is > 0) parts.Add($"Birds per batch: {demo.BirdsPerBatch}");
            if (!string.IsNullOrWhiteSpace(demo.Message)) parts.Add(demo.Message);
            return $"https://wa.me/{AppBrand.WhatsAppNumber}?text=" + Uri.EscapeDataString(string.Join("\n", parts));
        }
    }

    private record FeatureItem(string Icon, string Title, string Text);
    private static readonly FeatureItem[] FeatureList =
    {
        new("edit_note", "Quick daily records", "Deaths, culls, feed bags, water, weight and shed temperature — with \"same as yesterday\" and checks for typing mistakes."),
        new("speed", "Batch score & advisor", "A 0–100 score for every active batch, with plain advice on FCR, growth, livability, vaccinations and shed conditions."),
        new("monitoring", "Growth vs breed standard", "Body weight and FCR compared day by day with the Cobb/Ross target for the bird's age."),
        new("inventory_2", "Feed Stock", "Deliveries minus consumption, and a warning before feed runs out."),
        new("vaccines", "Vaccination schedule", "ND, IB and Gumboro doses on time, with reminders and a health log."),
        new("request_quote", "Settlement check", "Expected growing charge, FCR incentive and mortality deduction from your integrator's terms and your own records."),
        new("picture_as_pdf", "PDF reports", "Batch close-out, batch comparison and financial reports to print or share."),
        new("payments", "Income & expenses", "Shed expenses by batch, a live income projection before lifting, and profit per bird after settlement."),
        new("handshake", "Integrator terms", "Chick cost, feed bag weight, growing charge, FCR incentive and mortality allowance for each integrator, kept up to date for you."),
        new("local_shipping", "Lifting & settlement", "Record each lifting with birds, weight, vehicle and DC number, then the settlement and payment due date."),
        new("home_work", "Multiple houses & roles", "Every shed on one dashboard; each user sees only the houses and actions allowed for their role."),
        new("smart_toy", "AI health check", "Photograph sick birds and get possible causes, urgency and what to do now — plus a farm assistant that answers questions about your batch."),
        new("chat", "WhatsApp Alerts", "Death spikes, heat, low feed, vaccinations and an evening summary sent to your phone."),
        new("translate", "English & Telugu", "Switch language any time — screens, advice and reports follow."),
        new("palette", "Your farm's branding", "Your farm name, logo and colours on every screen your team uses."),
    };

    private record GalleryItem(string File, string Caption);
    private static readonly GalleryItem[] Gallery =
    {
        new("chicks-brooding.jpg", "Brooding"),
        new("bird-drinking.jpg", "Water"),
        new("cooling-pads.jpg", "Cooling pads"),
        new("bird-weighing.jpg", "Sample weighing"),
        new("tunnel-fans-sunset.jpg", "Tunnel ventilation"),
        new("shed-interior.jpg", "Grow-out"),
        new("feed-silo.jpg", "Feed"),
        new("healthy-birds.jpg", "Healthy flock"),
    };

    private record FaqItem(string Q, string A);
    private static readonly FaqItem[] Faq =
    {
        new("How do I get an account?", "Your farm admin creates a username and password for you. For a new farm, call or WhatsApp the BroilIQ team on +91 90307 05320 and we'll set it up."),
        new("Does it work on a mobile phone?", "Yes. BroilIQ runs in the phone's browser — no app to install — and is designed for use inside the shed."),
        new("Can I use it in Telugu?", "Yes. Tap EN / తె at the top of any page. Your choice is remembered on every device you sign in on."),
