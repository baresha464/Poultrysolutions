@page "/settings"
@inject AuthService AuthService

<div class="page-title">Settings</div>

<div class="card" style="padding:4px 10px;">
    <a class="list-row" href="settings/features">
        <div>
            <div class="list-row-title">@L["Features"]</div>
            <div class="list-row-sub">@L["AI Assistant and WhatsApp alerts — see what's on or request them"]</div>
        </div>
        <span class="dd-caret">▸</span>
    </a>
    <a class="list-row" href="settings/whatsapp">
        <div>
            <div class="list-row-title">@L["WhatsApp Alerts"]</div>
            <div class="list-row-sub">@L["Death spikes, heat, low feed, vaccinations and a daily summary on your phone"]</div>
        </div>
        <span class="dd-caret">▸</span>
    </a>
    @if (AuthService.HasPermission(Permissions.Houses.View))
    {
        <a class="list-row" href="houses">
            <div>
                <div class="list-row-title">Houses</div>
                <div class="list-row-sub">Manage sheds and see each one's batch history</div>
            </div>
            <span class="dd-caret">▸</span>
        </a>
    }
    @if (AuthService.HasPermission(Permissions.Integrators.View))
    {
        <a class="list-row" href="settings/integrators">
            <div>
                <div class="list-row-title">Integrators / Companies</div>
                <div class="list-row-sub">Integrators enabled for your farm and their rates</div>
            </div>
            <span class="dd-caret">▸</span>
        </a>
    }
    @if (AuthService.HasPermission(Permissions.Users.View))
    {
        <a class="list-row" href="settings/users">
            <div>
                <div class="list-row-title">Users</div>
                <div class="list-row-sub">Who can log in, and which roles they hold</div>
            </div>
            <span class="dd-caret">▸</span>
        </a>
    }
    @if (AuthService.HasPermission(Permissions.Roles.View))
    {
        <a class="list-row" href="settings/roles">
            <div>
                <div class="list-row-title">Roles</div>
                <div class="list-row-sub">Create roles and choose what each one can access</div>
            </div>
            <span class="dd-caret">▸</span>
        </a>
    }
    @if (AuthService.IsSystemAdmin)
    {
        <a class="list-row" href="settings/branding">
            <div>
                <div class="list-row-title">Branding</div>
                <div class="list-row-sub">App name, logo and colors for your organization</div>
            </div>
            <span class="dd-caret">▸</span>
        </a>
    }
</div>
