@page "/batch/{BatchId:int}/feed/new"
@page "/batch/{BatchId:int}/feed/{RecordId:int}"
@inject FarmService FarmService
@inject AuthService AuthService
@inject NavigationManager Nav

<div class="page-title">@L["Feed Delivery"]</div>

@if (!CanEdit || !batchAccessible)
{
    <div class="card empty-state">@L["You don't have permission to do this."]</div>
}
else
{
    <EditForm Model="feed" OnValidSubmit="Save">
        <div class="card">
            <div class="form-grid">
                <div class="field">
                    <label>@L["Date"]</label>
                    <InputDate @bind-Value="feed.Date" />
                </div>
                <div class="field">
                    <label>@L["Feed Type"]</label>
                    <Dropdown TValue="string" @bind-Value="feed.FeedType" Options="FeedTypeOptions" />
                </div>
                <div class="field">
                    <label>@L["Bags"]</label>
                    <InputNumber @bind-Value="feed.Bags" />
                </div>
                <div class="field">
                    <label>@L["Bag Weight (kg)"]</label>
                    <input type="text" value="@feed.BagWeightKg.ToString("0.##")" readonly title="@L["Set by the integrator"]" />
                </div>
                <div class="field">
                    <label>@L["DC Number"]</label>
                    <InputText @bind-Value="feed.DcNumber" />
                </div>
                <div class="field full">
                    <label>@L["Remarks"]</label>
                    <InputTextArea @bind-Value="feed.Remarks" />
                </div>
            </div>
            <div class="list-row"><span>@L["Total"]</span><b>@feed.TotalKg.ToString("N0") kg</b></div>
        </div>

        <div class="action-row">
            <button type="submit" class="btn btn-primary btn-block">@L["Save"]</button>
            @if (RecordId.HasValue && AuthService.HasPermission(Permissions.Feed.Delete))
            {
                <button type="button" class="btn btn-danger" @onclick="Delete">@L["Delete"]</button>
            }
        </div>
    </EditForm>
}

@code {
    [Parameter] public int BatchId { get; set; }
    [Parameter] public int? RecordId { get; set; }
    private FeedDelivery feed = new();
    private bool batchAccessible;

    private bool CanEdit => AuthService.HasPermission(RecordId.HasValue ? Permissions.Feed.Edit : Permissions.Feed.Add);

    // Stored value stays English; only the label is translated.
    private (string Value, string Label)[] FeedTypeOptions => new[] { "Pre-starter", "Starter", "Finisher" }
        .Select(v => (v, L[v].Value)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        feed.BatchId = BatchId;
        var batch = await FarmService.GetBatchAsync(BatchId);
        batchAccessible = batch is not null;
        if (batch?.Integrator is not null) feed.BagWeightKg = batch.Integrator.BagWeightKg;
        if (RecordId.HasValue)
        {
            var list = await FarmService.GetFeedDeliveriesAsync(BatchId);
            var existing = list.FirstOrDefault(r => r.Id == RecordId.Value);
            if (existing != null) feed = existing;
        }
    }

    private async Task Save()
    {
        await FarmService.SaveFeedDeliveryAsync(feed);
        Nav.NavigateTo($"batch/{BatchId}");
    }

    private async Task Delete()
    {
        if (RecordId.HasValue) await FarmService.DeleteFeedDeliveryAsync(RecordId.Value);
        Nav.NavigateTo($"batch/{BatchId}");
    }
}
