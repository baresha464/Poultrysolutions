@page "/settings/features"
@inject TenantFeatureService FeatureService
@inject AuthService AuthService

<PageTitle>@L["Features"] — @(AuthService.CurrentTenant?.Name ?? AppBrand.Name)</PageTitle>

<div class="page-head">
    <div>
        <a href="settings" style="font-size:12px; font-weight:700; color:var(--ink-soft); text-decoration:none;">← @L["Settings"]</a>
        <h1 class="page-title" style="margin-top:4px;">@L["Features"]</h1>
        <div class="page-head-sub">@L["Optional features are switched on for your farm by the platform administrator. Request any you'd like to use."]</div>
    </div>
</div>

@if (status is null)
{
    <p class="empty-state">@L["Loading…"]</p>
}
else
{
    @if (status.AiReady)
    {
        <div class="card feature-lock on">
            <div class="feature-lock-icon"><span class="material-symbols-outlined">smart_toy</span></div>
            <div class="feature-lock-body">
                <div class="feature-lock-title">@L["AI Assistant"] <span class="status-chip">@L["Active"]</span></div>
                <p class="calc-note" style="margin:4px 0 0;">@L["Open any batch and go to the AI Assistant tab."]</p>
            </div>
        </div>
    }
    else
    {
        <FeatureRequestCard Feature="@Features.AiAssistant" Icon="smart_toy" Enabled="status.AiEnabled"
                            Description="@L["Upload photos of sick birds for an instant health check, and ask questions about your batch in English or Telugu. The assistant reads your own daily records, weights, feed and health log."]" />
    }

    @if (status.WhatsAppEnabled)
    {
        <div class="card feature-lock on">
            <div class="feature-lock-icon"><span class="material-symbols-outlined">chat</span></div>
            <div class="feature-lock-body">
                <div class="feature-lock-title">@L["WhatsApp Alerts"] <span class="status-chip @(status.WhatsAppLive ? "" : "amber")">@L[status.WhatsAppLive ? "Active" : "Test mode"]</span></div>
                <p class="calc-note" style="margin:4px 0 0;"><a href="settings/whatsapp">@L["Choose your alerts and WhatsApp number"] →</a></p>
            </div>
        </div>
    }
    else
    {
        <FeatureRequestCard Feature="@Features.WhatsAppAlerts" Icon="chat"
                            Description="@L["Death spikes, heat, low feed, vaccination reminders and an evening summary sent to your phone on WhatsApp, in English or Telugu."]" />
    }
}

@code {
    private FeatureStatus? status;

    protected override async Task OnInitializedAsync() =>
        status = await FeatureService.GetStatusAsync(AuthService.CurrentTenantId);
}
