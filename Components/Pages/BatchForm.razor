@page "/batch/new"
@page "/batch/{Id:int}/edit"
@inject FarmService FarmService
@inject AuthService AuthService
@inject NavigationManager Nav

<div class="page-title">@(Id.HasValue ? "Edit Batch" : "New Batch")</div>

@if (!AuthService.HasPermission(Id.HasValue ? Permissions.Batches.Edit : Permissions.Batches.Add))
{
    <div class="card empty-state">You don't have permission to do this.</div>
}
else if (Id.HasValue && !loading && batch.Id == 0)
{
    <div class="card empty-state">Batch not found, or you don't have access to it.</div>
}
else
{
<EditForm Model="batch" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card">
        <div class="form-grid">
            <div class="field">
                <label>Batch Number *</label>
                <InputText @bind-Value="batch.BatchCode" placeholder="AMR-2026-05" />
            </div>
            <div class="field">
                <label>House *</label>
                <Dropdown TValue="int" Value="batch.HouseId" ValueChanged="v => batch.HouseId = v"
                          Options="houseOptions" Placeholder="Select house…" />
            </div>
            <div class="field">
                <label>Integrator / Company *</label>
                @if (integratorOptions.Count == 0)
                {
                    <div class="empty-state" style="padding:10px 0; text-align:left;">
                        No integrators are enabled for your farm yet. Please ask the platform administrator to add one.
                    </div>
                }
                else
                {
                    <Dropdown TValue="int" Value="batch.IntegratorId" ValueChanged="OnIntegratorChanged"
                              Options="integratorOptions" Placeholder="Select integrator…" />
                }
            </div>
            <div class="field">
                <label>Branch Code</label>
                <InputText @bind-Value="batch.BranchCode" placeholder="e.g. BR-04" />
            </div>
            <div class="field">
                <label>Breed</label>
                <InputText @bind-Value="batch.Breed" />
            </div>
            <div class="field">
                <label>Placement Date</label>
                <InputDate @bind-Value="batch.PlacementDate" />
            </div>
            <div class="field">
                <label>Chicks Placed</label>
                <InputNumber @bind-Value="batch.ChicksPlaced" />
            </div>
            <div class="field">
                <label>Chick Cost / Bird (₹)</label>
                <input type="text" readonly value="@ChickCostShown.ToString("0.00")" title="Set by the integrator" />
                <div class="field-hint">Set by the integrator@(SelectedIntegrator is { } si ? $" · feed bag {si.BagWeightKg:0.##} kg" : "")</div>
            </div>
            <div class="field">
                <label>Target Weight (kg)</label>
                <InputNumber @bind-Value="batch.TargetWeightKg" step="0.01" />
            </div>
            <div class="field full">
                <label>Notes</label>
                <InputTextArea @bind-Value="batch.Notes" />
            </div>
        </div>
    </div>

    @if (error is not null)
    {
        <div class="card empty-state">@error</div>
    }
    <div class="action-row">
        <button type="submit" class="btn btn-primary btn-block">Save Batch</button>
    </div>
</EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public int? HouseId { get; set; }
    private Batch batch = new();
    private List<(int Value, string Label)> houseOptions = new();
    private List<(int Value, string Label)> integratorOptions = new();
    private List<Integrator> integrators = new();
    private int originalIntegratorId;
    private string? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var houses = await FarmService.GetHousesAsync();
        houseOptions = houses.Select(h => (h.Id, h.Name)).ToList();

        integrators = await FarmService.GetIntegratorsAsync(activeOnly: true);

        if (Id.HasValue)
        {
            var existing = await FarmService.GetBatchAsync(Id.Value);
            if (existing != null)
            {
                batch = existing;
                originalIntegratorId = batch.IntegratorId;
                // Keep a since-deactivated/removed integrator selectable for the batch that already uses it.
                if (batch.Integrator is not null && integrators.All(i => i.Id != batch.IntegratorId))
                    integrators.Insert(0, batch.Integrator);
            }
        }
        else
        {
            batch.HouseId = HouseId ?? (houses.Count > 0 ? houses[0].Id : 0);
            if (integrators.Count > 0) OnIntegratorChanged(integrators[0].Id);
        }
        integratorOptions = integrators.Select(i => (i.Id, i.Name)).ToList();

        loading = false;
    }

    private Integrator? SelectedIntegrator => integrators.FirstOrDefault(i => i.Id == batch.IntegratorId);

    // Existing batches keep the chick cost recorded at placement unless moved to another integrator.
    private decimal ChickCostShown => batch.Id != 0 && batch.IntegratorId == originalIntegratorId
        ? batch.ChickCostPerBird
        : SelectedIntegrator?.ChickCostPerBird ?? 0;

    private void OnIntegratorChanged(int id)
    {
        batch.IntegratorId = id;
        if (batch.Id == 0 && SelectedIntegrator is { } i)
        {
            batch.Breed = i.DefaultBreed;
            batch.TargetWeightKg = i.TargetWeightKg;
        }
    }

    private async Task Save()
    {
        error = null;
        try
        {
            var id = await FarmService.SaveBatchAsync(batch);
            Nav.NavigateTo($"batch/{id}");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }
}
