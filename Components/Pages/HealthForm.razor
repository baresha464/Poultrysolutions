@page "/batch/{BatchId:int}/health/new"
@page "/batch/{BatchId:int}/health/{RecordId:int}"
@inject FarmService FarmService
@inject AuthService AuthService
@inject NavigationManager Nav

<div class="page-title">@L["Health Event"]</div>

@if (!CanEdit || !batchAccessible)
{
    <div class="card empty-state">@L["You don't have permission to do this."]</div>
}
else
{
    <EditForm Model="evt" OnValidSubmit="Save">
        <div class="card">
            <div class="form-grid">
                <div class="field">
                    <label>@L["Date"]</label>
                    <InputDate @bind-Value="evt.Date" />
                </div>
                <div class="field">
                    <label>@L["Type"]</label>
                    <Dropdown TValue="HealthEventType" @bind-Value="evt.Type" Options="TypeOptions" />
                </div>
                <div class="field">
                    <label>@L["Name"]</label>
                    <InputText @bind-Value="evt.Name" placeholder="@L["e.g. ND Lasota"]" />
                </div>
                <div class="field">
                    <label>@L["Dose"]</label>
                    <InputText @bind-Value="evt.Dose" placeholder="@L["e.g. 1 drop/bird"]" />
                </div>
                <div class="field">
                    <label>@L["Route"]</label>
                    <Dropdown TValue="string" @bind-Value="evt.Route" Options="RouteOptions" />
                </div>
                <div class="field">
                    <label>@L["Cost (₹)"]</label>
                    <InputNumber @bind-Value="evt.Cost" step="0.01" />
                </div>
                <div class="field full">
                    <label>@L["Remarks"]</label>
                    <InputTextArea @bind-Value="evt.Remarks" />
                </div>
            </div>
        </div>

        <div class="action-row">
            <button type="submit" class="btn btn-primary btn-block">@L["Save"]</button>
            @if (RecordId.HasValue && AuthService.HasPermission(Permissions.Health.Delete))
            {
                <button type="button" class="btn btn-danger" @onclick="Delete">@L["Delete"]</button>
            }
        </div>
    </EditForm>
}

@code {
    [Parameter] public int BatchId { get; set; }
    [Parameter] public int? RecordId { get; set; }
    private HealthEvent evt = new();
    private bool batchAccessible;

    private bool CanEdit => AuthService.HasPermission(RecordId.HasValue ? Permissions.Health.Edit : Permissions.Health.Add);

    // Stored values stay English; only the labels are translated.
    private (HealthEventType Value, string Label)[] TypeOptions => Enum.GetValues<HealthEventType>()
        .Select(t => (t, L[t.ToString()].Value)).ToArray();

    private (string Value, string Label)[] RouteOptions => new[] { "Drinking water", "Eye drop", "Spray", "Injection", "Feed mix" }
        .Select(r => (r, L[r].Value)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        evt.BatchId = BatchId;
        batchAccessible = await FarmService.GetBatchAsync(BatchId) is not null;
        if (RecordId.HasValue)
        {
            var list = await FarmService.GetHealthEventsAsync(BatchId);
            var existing = list.FirstOrDefault(r => r.Id == RecordId.Value);
            if (existing != null) evt = existing;
        }
    }

    private async Task Save()
    {
        await FarmService.SaveHealthEventAsync(evt);
        Nav.NavigateTo($"batch/{BatchId}");
    }

    private async Task Delete()
    {
        if (RecordId.HasValue) await FarmService.DeleteHealthEventAsync(RecordId.Value);
        Nav.NavigateTo($"batch/{BatchId}");
    }
}
