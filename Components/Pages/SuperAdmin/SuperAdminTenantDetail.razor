@page "/superadmin/tenants/{Id:int}"
@layout SuperAdminLayout
@inject PlatformAdminService PlatformAdminService
@inject NavigationManager Nav

<PageTitle>@(tenant?.Name ?? "Client") — Platform Admin</PageTitle>

@if (loading)
{
    <p class="empty-state">Loading…</p>
}
else if (tenant is null)
{
    <div class="card empty-state">Client not found.</div>
}
else
{
    <div class="page-title">@tenant.Name</div>

    <div class="card">
        <div class="form-grid single">
            <div class="field">
                <label>Status</label>
                <div>@(tenant.IsActive ? "Active" : "Deactivated")</div>
            </div>
            <div class="field">
                <label>Created</label>
                <div>@tenant.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</div>
            </div>
        </div>
    </div>

    <div class="action-row">
        @if (tenant.IsActive)
        {
            <button class="btn btn-danger btn-block" @onclick="Deactivate">Deactivate Client</button>
        }
        else
        {
            <button class="btn btn-primary btn-block" @onclick="Activate">Reactivate Client</button>
        }
    </div>

    <div class="section-title">Features</div>
    <TenantFeaturesEditor TenantId="Id" />

    <div class="section-title">Houses (@houses.Count)</div>
    <div class="card" style="padding:4px 16px;">
        @if (houses.Count == 0)
        {
            <div class="empty-state">No houses yet.</div>
        }
        @foreach (var h in houses)
        {
            <div class="list-row">
                <div>
                    <div class="list-row-title">@h.Name @(string.IsNullOrWhiteSpace(h.Code) ? "" : $"({h.Code})")</div>
                    <div class="list-row-sub">@(h.CapacityBirds > 0 ? $"Capacity {h.CapacityBirds:N0} birds" : "Capacity not set")</div>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <div class="form-grid">
            <div class="field">
                <label>New House Name</label>
                <input @bind="newHouseName" type="text" placeholder="@($"House {houses.Count + 1}")" />
            </div>
            <div class="field">
                <label>Code</label>
                <input @bind="newHouseCode" type="text" placeholder="@($"H{houses.Count + 1}")" />
            </div>
            <div class="field">
                <label>Capacity (birds)</label>
                <input @bind="newHouseCapacity" type="number" min="0" step="100" />
            </div>
        </div>
        @if (!string.IsNullOrEmpty(houseMessage))
        {
            <p>@houseMessage</p>
        }
    </div>
    <div class="action-row">
        <button class="btn btn-primary btn-block" @onclick="AddHouse" disabled="@addingHouse">+ Add House</button>
    </div>

    <div class="section-title">Allowed Integrators (@selectedIntegrators.Count)</div>
    <div class="card" style="padding:4px 16px;">
        @if (integrators.Count == 0)
        {
            <div class="empty-state">No integrators yet. <a href="superadmin/integrators/new">Add one</a>.</div>
        }
        @foreach (var i in integrators)
        {
            <label class="check-row">
                <input type="checkbox" checked="@selectedIntegrators.Contains(i.Id)" @onchange="e => ToggleIntegrator(i.Id, (bool)e.Value!)" />
                <span>
                    <a href="@($"superadmin/integrators/{i.Id}")">@i.Name</a> @(i.IsActive ? "" : "(inactive)")
                    <span class="list-row-sub">· chick ₹@i.ChickCostPerBird.ToString("0.00") · bag @i.BagWeightKg.ToString("0.##") kg · ₹@i.GrowingChargePerKg.ToString("0.00")/kg</span>
                </span>
            </label>
        }
        @if (!string.IsNullOrEmpty(integratorMessage))
        {
            <p>@integratorMessage</p>
        }
    </div>
    <div class="action-row">
        <button class="btn btn-primary btn-block" @onclick="SaveIntegrators">Save Allowed Integrators</button>
    </div>

    <div class="section-title">Reset Admin Password</div>
    <div class="card">
        <div class="form-grid single">
            <div class="field">
                <label>New Password *</label>
                <input @bind="newPassword" type="text" placeholder="Leave blank to generate one" />
            </div>
        </div>
        @if (!string.IsNullOrEmpty(resetMessage))
        {
            <p>@resetMessage</p>
        }
    </div>
    <div class="action-row">
        <button class="btn btn-primary btn-block" @onclick="ResetPassword">Reset Password</button>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private bool loading = true;
    private Tenant? tenant;
    private string newPassword = "";
    private string? resetMessage;

    private List<House> houses = new();
    private string newHouseName = "";
    private string newHouseCode = "";
    private int newHouseCapacity = 5000;
    private string? houseMessage;
    private bool addingHouse;

    protected override async Task OnInitializedAsync()
    {
        tenant = await PlatformAdminService.GetTenantAsync(Id);
        if (tenant is not null)
        {
            houses = await PlatformAdminService.GetTenantHousesAsync(Id);
            integrators = await PlatformAdminService.GetIntegratorsAsync();
            selectedIntegrators = (await PlatformAdminService.GetTenantIntegratorIdsAsync(Id)).ToHashSet();
        }
        loading = false;
    }

    private List<Integrator> integrators = new();
    private HashSet<int> selectedIntegrators = new();
    private string? integratorMessage;

    private void ToggleIntegrator(int id, bool on)
    {
        if (on) selectedIntegrators.Add(id); else selectedIntegrators.Remove(id);
        integratorMessage = null;
    }

    private async Task SaveIntegrators()
    {
        await PlatformAdminService.SetTenantIntegratorsAsync(Id, selectedIntegrators);
        integratorMessage = "Saved. Removed integrators disappear from the client's new-batch list; existing batches are unchanged.";
    }

    private async Task AddHouse()
    {
        if (houses.Any(h => string.Equals(h.Name, newHouseName.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            houseMessage = $"This client already has a house named \"{newHouseName.Trim()}\".";
            return;
        }

        addingHouse = true;
        var house = await PlatformAdminService.AddHouseAsync(Id, newHouseName, newHouseCode, newHouseCapacity);
        houses = await PlatformAdminService.GetTenantHousesAsync(Id);
        houseMessage = $"{house.Name} added. The client's admin will see it right away (assign it to other users under Settings → Users).";
        newHouseName = "";
        newHouseCode = "";
        addingHouse = false;
    }

    private async Task Deactivate()
    {
        await PlatformAdminService.SetTenantActiveAsync(Id, false);
        tenant = await PlatformAdminService.GetTenantAsync(Id);
    }

    private async Task Activate()
    {
        await PlatformAdminService.SetTenantActiveAsync(Id, true);
        tenant = await PlatformAdminService.GetTenantAsync(Id);
    }

    private async Task ResetPassword()
    {
        var password = string.IsNullOrWhiteSpace(newPassword) ? GenerateSuggestedPassword() : newPassword;
        var ok = await PlatformAdminService.ResetTenantAdminPasswordAsync(Id, password);
        resetMessage = ok
            ? $"New password: {password} — share this with the client now, it won't be shown again."
            : "No admin user found for this client.";
        newPassword = "";
    }

    private static string GenerateSuggestedPassword()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";
        var rnd = System.Security.Cryptography.RandomNumberGenerator.GetBytes(16);
        var result = new char[16];
        for (var i = 0; i < 16; i++) result[i] = chars[rnd[i] % chars.Length];
        return new string(result);
    }
}
