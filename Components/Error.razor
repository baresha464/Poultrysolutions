@page "/Error"
@attribute [AllowAnonymous]
@layout Layout.EmptyLayout

<PageTitle>Error</PageTitle>

<div class="login-screen">
    <div class="login-card" style="text-align:left;">
        <h1 class="login-title">Something went wrong</h1>
        <p class="login-sub">An unexpected error occurred. Please try again, or contact your administrator if it continues.</p>
        <a class="btn btn-primary btn-block" href="/">Back to Home</a>
    </div>
</div>
