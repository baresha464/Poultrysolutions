@page "/Account/Login"
@attribute [AllowAnonymous]
@layout EmptyLayout

<PageTitle>@L["Sign In"] — @AppBrand.Name</PageTitle>

<div class="auth-screen">
    <div class="auth-visual">
        <div class="auth-visual-top">
            <img src="@AppBrand.MarkUrl" alt="@AppBrand.Name" />
            <div>
                <div class="auth-visual-top-name">@AppBrand.Name</div>
                <div class="auth-visual-top-sub">@AppBrand.Tagline</div>
            </div>
        </div>

        <div class="auth-visual-body">
            <span class="auth-visual-badge">
                <span class="material-symbols-outlined">shield_lock</span> @L["Internal Operations Portal"]
            </span>
            <h1 class="auth-visual-title">@L["Precision Broiler Farm Operations Console"]</h1>
            <p class="auth-visual-sub">
                @L["Track every house, batch and daily record in one place — from placement to settlement — across all your sheds."]
            </p>
            <ul class="auth-visual-points">
                <li><span class="material-symbols-outlined">monitoring</span> @L["Batch-wise growth, FCR & livability at a glance"]</li>
                <li><span class="material-symbols-outlined">home_work</span> @L["One dashboard for every house and active flock"]</li>
                <li><span class="material-symbols-outlined">group</span> @L["Role-based access for supervisors and field staff"]</li>
            </ul>
        </div>
    </div>

    <div class="auth-panel">
        <div class="auth-card">
            <div class="auth-card-head">
                <img class="auth-brand-logo" src="@AppBrand.LogoUrl" alt="@AppBrand.Name — @AppBrand.Tagline" />
                <h1 class="visually-hidden">@AppBrand.Name</h1>
                <p class="auth-card-sub">@L["Sign in to continue"]</p>
                <div style="margin-top:10px;"><LanguageToggle /></div>
            </div>

            @if (Error == "1")
            {
                <div class="auth-alert">
                    <span class="material-symbols-outlined">error</span>
                    <span>@L["Invalid username or password. Please contact your administrator."]</span>
                </div>
            }
            else if (Error == "2")
            {
                <div class="auth-alert">
                    <span class="material-symbols-outlined">error</span>
                    <span>@L["This account is deactivated. Contact your administrator for access."]</span>
                </div>
            }

            <form method="post" action="Account/LoginSubmit" class="auth-form">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <input type="hidden" name="lang" value="@AppLanguages.Current" />

                <div class="field">
                    <label for="usernameInput">@L["Username"]</label>
                    <div class="auth-input-wrap">
                        <span class="material-symbols-outlined auth-input-icon">badge</span>
                        <input id="usernameInput" name="username" type="text" autocomplete="username"
                               placeholder="e.g. supervisor_ramesh" required class="auth-input" />
                    </div>
                </div>

                <div class="field">
                    <label for="passwordInput">@L["Password"]</label>
                    <div class="auth-input-wrap">
                        <span class="material-symbols-outlined auth-input-icon">lock</span>
                        <input id="passwordInput" name="password" type="password" autocomplete="current-password"
                               placeholder="••••••••••••" required class="auth-input" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block auth-submit">
                    @L["Sign In"] <span class="material-symbols-outlined">login</span>
                </button>
            </form>

            <div class="auth-footnote">
                <p>@L["Internal Operations Portal"]</p>
                <p class="auth-footnote-sub">@L["Authorized personnel only."]</p>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
}
