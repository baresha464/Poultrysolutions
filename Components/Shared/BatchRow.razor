@if (Batch is not null)
{
    <a class="list-row" href="@($"batch/{Batch.Id}")">
        <div>
            <div class="list-row-title">@Batch.BatchCode</div>
            <div class="list-row-sub">
                @L["Placed"] @Batch.PlacementDate.ToString("dd MMM yyyy") · @L["{0:N0} chicks", Batch.ChicksPlaced] · @Batch.Integrator?.Name
            </div>
        </div>
        <span class="badge @(Batch.Status == BatchStatus.Closed ? "closed" : "")">
            @(Batch.Status == BatchStatus.Closed ? L["Closed"] : L["Day {0}", Batch.AgeDays])
        </span>
    </a>
}

@code {
    [Parameter, EditorRequired] public Batch? Batch { get; set; }
}
